# ==========================================
# ChaiStore - Environment Variables Template
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"

# JWT Authentication Secrets (Use high-entropy keys with at least 32 characters in production)
JWT_ACCESS_SECRET="your_secure_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_secure_jwt_refresh_secret_key_here"
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend
CORS_ORIGIN="http://localhost:5173"

# Frontend Configuration
VITE_API_URL="http://localhost:5000/api/v1"
